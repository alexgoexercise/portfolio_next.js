# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data files
/data

.vercel

# blender backup files
*.blend1
__pycache__/

# large downloaded sources (drum kit, MPFB add-on and asset pack): too big for GitHub
blender/assets/

# generated by the scripts in blender/ (run them to recreate)
blender/*.blend
blender/renders/
